{
  "name": "hermes-setup",
  "version": "0.3.0-preview.2",
  "private": true,
  "description": "Guided local Hermes, Docker sandbox and Tailscale installation",
  "author": "Ben",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.benczb.hermes.setup",
    "productName": "Hermes Setup Companion",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "*.cjs",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts/setup-macos-linux.sh",
        "to": "installer/setup-macos-linux.sh"
      },
      {
        "from": "../scripts/setup-windows.ps1",
        "to": "installer/setup-windows.ps1"
      },
      {
        "from": "../profiles/starter-agent/SOUL.md",
        "to": "installer/SOUL.md"
      }
    ],
    "artifactName": "Hermes-Companion-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ],
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Hermes-Setup-Companion-${version}-windows-${arch}.exe"
    }
  }
}
